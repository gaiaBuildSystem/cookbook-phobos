    },
    "hostDeps": [
        "git",
        "pkg-config",
        "ostree",
        "rsync",
        "asn1c",
        "build-essential",
        "cmake",
        "curl",
        "libarchive-dev",
        "libboost-dev",
        "libboost-log-dev",
        "libboost-program-options-dev",
        "libcurl4-openssl-dev",
        "libpthread-stubs0-dev",
        "libsodium-dev",
        "libsqlite3-dev",
        "python3",
        "python3-requests",
        "libglib2.0-dev",
        "file",
        "libostree-dev",
        "libssl-dev",
        "openjdk-17-jre-headless"
    ],
    "targetDeps": [
        "openjdk-17-jre-headless"
    ],
    "fetchRecipes": [
        "fetch.xsh"
