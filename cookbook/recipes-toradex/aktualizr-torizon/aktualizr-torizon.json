{
    "name": "aktualizr-torizon",
    "type": "application",
    "priority": 0,
    "support": [
        "linux/amd64",
        "linux/arm64"
    ],
    "source": "https://github.com/gaiaBuildSystem/aktualizr.git",
    "ref": {
        "linux/arm64": "e317a8cc2101613b95ecbb9bcb98bcb751fa63c7",
        "linux/amd64": "e317a8cc2101613b95ecbb9bcb98bcb751fa63c7"
    },
    "hostAsContainer": true,
    "containerImage": {
        "image": "debian",
        "tag": "bookworm"
